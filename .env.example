# Copy this file to .env beside server.mjs. Set only providers you want to use.
# Never commit .env or share API keys in a project, screenshot or chat.
OPENAI_API_KEY=
HESTIA_OPENAI_MODEL=gpt-image-2.5-sunburst
GEMINI_API_KEY=
HESTIA_GEMINI_MODEL=gemini-nano-banana-2.1
# Optional service that implements OpenAI multipart /images/edits and b64_json output.
HESTIA_COMPATIBLE_NAME=OpenAI-compatible
HESTIA_COMPATIBLE_API_KEY=
HESTIA_COMPATIBLE_EDIT_URL=
HESTIA_COMPATIBLE_MODEL=
# HESTIA_DATA_DIR=D:\HestiaWorkspace
# PORT=4173

# Cloudflare Workers AI: limited free allocation, no automatic paid fallback.
# Token requires Workers AI: Read and Edit permissions for your selected account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional local ComfyUI. Install a compatible SD/SDXL checkpoint separately.
HESTIA_COMFYUI_URL=http://127.0.0.1:8188
HESTIA_COMFYUI_CHECKPOINT=

# Curated image editing and Auto Free (qualify real outputs in AI models first).
IMAGEROUTER_API_KEY=
# Optional curated free vision for Plan lab; this does not generate images.
OPENROUTER_API_KEY=
