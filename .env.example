# Copy this file to .env beside server.mjs. Set only providers you want to use.
# Never commit .env or share API keys in a project, screenshot or chat.
OPENAI_API_KEY=
HESTIA_OPENAI_MODEL=gpt-image-2.5-sunburst
GEMINI_API_KEY=
HESTIA_GEMINI_MODEL=gemini-nano-banana-2.1
# Optional service that implements OpenAI multipart /images/edits and b64_json output.
HESTIA_COMPATIBLE_NAME=OpenAI-compatible
HESTIA_COMPATIBLE_API_KEY=
HESTIA_COMPATIBLE_EDIT_URL=
HESTIA_COMPATIBLE_MODEL=
